# ============================================================
# ຕົວຢ່າງ environment variables — copy ເປັນ .env ແລ້ວຕື່ມຄ່າຈິງ:
#   cp .env.example .env
# ============================================================

# Django
# Generate key ໃໝ່: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=''

# Production ເທົ່ານັ້ນ: domain ຂອງເວັບ (ຄັ່ນດ້ວຍ comma)
# DJANGO_ALLOWED_HOSTS=hugkerb.com,www.hugkerb.com

# Base URL ຂອງເວັບ — ໃຊ້ສ້າງລິ້ງ Customer Portal ໃນ QR ແລະ ຂໍ້ຄວາມແຈ້ງເຕືອນ
# Production ຕົວຢ່າງ: https://hugkerb.com
SITE_BASE_URL=http://127.0.0.1:8000

# Telegram Bot ສຳລັບແຈ້ງເຕືອນລູກຄ້າ (ສ້າງ bot ຜ່ານ @BotFather ແລ້ວ copy token ມາໃສ່)
TELEGRAM_BOT_TOKEN=''

# OpenRouter AI API (Scope 2.4 — ໃຊ້ API key ຂອງຮ້ານ)
OPENROUTER_API_KEY=''
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_MAX_TOKENS=2000

# Database (ໃຊ້ໃນ production - PostgreSQL)
DB_NAME=hugkerb_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
